{
  "name": "dsh-workflow-kit",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "docs",
    "scripts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build-skills.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "prepare:local": "node scripts/prepare-local.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "dsh-codex-kit-backend": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
